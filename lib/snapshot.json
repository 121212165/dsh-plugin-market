      ],
      "installOrder": "按 members 顺序：task-forge → pinboard → fact-vault",
      "conflicts": [],
      "verify": [
        "dump-config 含三个 id",
        "/pin 后新开会话系统提示含该条；/fact 能检索到带出处的同一事实"
      ],
      "curator": "editor",
      "updatedAt": "2026-11-20"
    },
    {
      "id": "saving-combo",
      "name": "省钱组合",
      "oneLiner": "同读一份 per-call 成本台账，拦缓存、算预测、对账",
